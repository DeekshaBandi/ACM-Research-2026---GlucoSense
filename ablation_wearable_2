def hrv_feats(ibi_s):
    ms = np.asarray(ibi_s, float)*1000
    ms = ms[(ms>300)&(ms<2000)]
    n  = len(ms)
    null = {k:np.nan for k in ["rmssd","sdnn","pnn50","mean_rr","cv_rr",
                                "lf_hf","sd1","sd2","sd_ratio","dfa1"]}
    null["n_ibi"] = n
    if n < 30: return null
    diff = np.diff(ms)
    d = dict(n_ibi=n, mean_rr=np.mean(ms), sdnn=np.std(ms),
             rmssd=np.sqrt(np.mean(diff**2)),
             pnn50=(np.sum(np.abs(diff)>50)/n)*100,
             cv_rr=(np.std(ms)/np.mean(ms))*100)
    try:
        ts = np.cumsum(ms)/1000.0
        tu = np.arange(ts[0],ts[-1],0.25)
        fi = interp1d(ts,ms,bounds_error=False,fill_value="extrapolate")
        iu = fi(tu)-fi(tu).mean()
        fr = np.fft.rfftfreq(len(iu),0.25)
        ps = np.abs(np.fft.rfft(iu))**2/len(iu)
        lf = np.trapz(ps[(fr>=0.04)&(fr<0.15)],fr[(fr>=0.04)&(fr<0.15)])
        hf = np.trapz(ps[(fr>=0.15)&(fr<0.40)],fr[(fr>=0.15)&(fr<0.40)])
        d["lf_hf"] = lf/hf if hf>0 else np.nan
    except: d["lf_hf"] = np.nan
    sd1=np.sqrt(0.5)*np.std(diff)
    sd2=np.sqrt(max(2*np.var(ms)-0.5*np.var(diff),0))
    d.update(sd1=sd1,sd2=sd2,sd_ratio=sd1/sd2 if sd2>0 else np.nan)
    try:
        y=np.cumsum(ms[:500]-ms[:500].mean()); F=[]
        for s in [4,8,16,32]:
            if len(y)<s*2: continue
            rm=[np.sqrt(np.mean((seg-np.polyval(np.polyfit(range(s),seg,1),range(s)))**2))
                for seg in [y[i*s:(i+1)*s] for i in range(len(y)//s)] if len(seg)==s]
            if rm: F.append(np.mean(rm))
        d["dfa1"]=float(np.polyfit(np.log([4,8,16,32][:len(F)]),np.log(np.array(F)+1e-9),1)[0]) if len(F)>=3 else np.nan
    except: d["dfa1"]=np.nan
    return d
 
def hr_feats(hr_vals):
    h=np.asarray(hr_vals,float); h=h[(h>30)&(h<220)]
    if len(h)<20: return {k:np.nan for k in ["mean_hr","std_hr","min_hr","max_hr","hr_iqr","hr_p10","hr_p90"]}
    return dict(mean_hr=np.mean(h),std_hr=np.std(h),min_hr=np.min(h),max_hr=np.max(h),
                hr_iqr=np.percentile(h,75)-np.percentile(h,25),
                hr_p10=np.percentile(h,10),hr_p90=np.percentile(h,90))
 
