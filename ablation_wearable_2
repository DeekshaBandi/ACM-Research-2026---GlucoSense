def fit_pred(X_tr, y_tr, X_te):
    imp = SimpleImputer(strategy="median")
    X_tr = imp.fit_transform(X_tr)
    X_te = imp.transform(X_te)
    # drop columns that are all-zero (were all-NaN before imputation)
    nonzero_cols = np.where(X_tr.std(axis=0) > 0)[0]
    if len(nonzero_cols) == 0:
        return np.full(len(X_te), np.nan)
    X_tr = X_tr[:, nonzero_cols]
    X_te = X_te[:, nonzero_cols]
    scaler = StandardScaler()
    X_tr = scaler.fit_transform(X_tr)
    X_te = scaler.transform(X_te)
    models = [
        RandomForestClassifier(n_estimators=300, class_weight="balanced",
                               max_depth=6, random_state=42),
        GradientBoostingClassifier(n_estimators=200, max_depth=3,
                                   learning_rate=0.05, random_state=42),
        LogisticRegression(class_weight="balanced", max_iter=1000,
                           random_state=42)
    ]
    probas = []
    for m in models:
        try:
            m.fit(X_tr, y_tr)
            probas.append(m.predict_proba(X_te)[:, 1])
        except Exception:
            pass
    return np.mean(probas, axis=0) if probas else np.full(len(X_te), np.nan)

def best_thr(y_true, y_prob):
    best_t, best_f1 = 0.5, 0.0
    for t in np.linspace(0.1, 0.9, 81):
        f1 = f1_score(y_true, (y_prob >= t).astype(int), zero_division=0)
        if f1 > best_f1:
            best_f1, best_t = f1, t
    return best_t

def score(y_true, y_pred, y_prob):
    cm = confusion_matrix(y_true, y_pred, labels=[0, 1])
    tn, fp, fn, tp = cm.ravel()
    return dict(
        f1=f1_score(y_true, y_pred, zero_division=0),
        auroc=roc_auc_score(y_true, y_prob) if len(np.unique(y_true)) > 1 else np.nan,
        balanced_acc=balanced_accuracy_score(y_true, y_pred),
        sensitivity=recall_score(y_true, y_pred, zero_division=0),
        specificity=tn / (tn + fp) if (tn + fp) > 0 else np.nan,
        precision=precision_score(y_true, y_pred, zero_division=0),
        TP=int(tp), TN=int(tn), FP=int(fp), FN=int(fn)
    )
